      <Item identifier="aluminium" amount="2" />
      <Item identifier="organicfiber" amount="2" />
      <Item identifier="fpgacircuit" amount="1" />
    </Fabricate>
    <Body width="416" height="192" density="15" />
    <Holdable selectkey="Select" pickkey="Use" slots="RightHand+LeftHand" msg="ItemMsgDetachWrench" PickingTime="10.0" aimpos="65,-10" handle1="0,0" attachable="true" aimable="true" attached="true" attachedByDefault="true">
