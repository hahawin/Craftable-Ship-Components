        <reduceaffliction type="damage" strength="0.150" />
        <reduceaffliction identifier="concussion" strength="0.100" />
        <reduceaffliction identifier="infection" strength="0.050" />
        <reduceaffliction identifier="bloodloss" strength="0.100" />
